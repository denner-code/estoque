# No Railway, esta variável é criada automaticamente quando você
# adiciona o plugin PostgreSQL ao projeto. Não é necessário preenchê-la
# manualmente em produção.
#
# Para rodar localmente na sua máquina, copie este arquivo para ".env"
# e cole a "Connection String" do seu banco Postgres (local ou do Railway).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/estoque_tecidos

# Porta local (o Railway define isso automaticamente em produção)
PORT=3000
